# LiveKit WebRTC credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Set the same name on frontend and worker for LiveKit Cloud automatic startup.
LIVEKIT_AGENT_NAME=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Groq API keys (comma-separated for key pool)
GROQ_API_KEYS=gsk_your_groq_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here

# Voice agent parameters
AGENT_NAME=Yuki
AGENT_IDLE_PROCESSES=1
VOICE_NAME=auto
VOICE_SPEED=1.05
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin

# Langfuse observability
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production

# Production admission. Frontend and worker share the same Redis database.
SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_ORIGIN=
# Only select an ingress that overwrites its trusted header and blocks direct access.
TRUSTED_INGRESS=
# Default to a restricted beta; explicitly set PUBLIC_ACCESS=true for public use.
YUKI_ACCESS_CODE=
PUBLIC_ACCESS=false
ALLOW_NEW_SESSIONS=true
MAX_CONCURRENT_SESSIONS=1
MAX_SESSION_SECONDS=300
KOKORO_THREADS=2
# Organization/model limits: set BELOW your actual Groq allocation; keys do not multiply it.
GROQ_RPM_LIMIT=20
GROQ_TPM_LIMIT=8000
TELEMETRY_ENABLED=false
# Worker only: set production on deployed workers; shared quota controls are required.
YUKI_ENV=development

DAILY_PROVIDER_REQUEST_LIMIT=500
GROQ_DAILY_TOKEN_LIMIT=200000
# Scrape internally; do not expose metrics to the public Internet.
PROMETHEUS_PORT=9090
